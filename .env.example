GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:5173
DASHBOARD_DATA_DIR=./backend/data
DASHBOARD_TIMEZONE=Asia/Ho_Chi_Minh

# QR downloads: same frontend/API with either provider.
PHOTO_STORAGE_PROVIDER=local
# Use a stable public HTTPS origin. Empty uses the current browser origin (local testing).
PUBLIC_APP_URL=
# 0 retains QR photos until manual deletion; set a positive number to expire new photos.
PHOTO_RETENTION_DAYS=0
# At least 32 random characters. Required for firebase; local auto-saves a key in DASHBOARD_DATA_DIR.
PHOTO_SIGNING_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Optional outside Google Cloud: service-account JSON in a secret variable. Never use a VITE_ prefix.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PHOTO_COLLECTION=photobooth_photos
